@model films_dz12._08._2026.Models.Movie

@{
    ViewData["Title"] = "Редактировать фильм";
}

<h1>Редактировать фильм</h1>

<div asp-validation-summary="All"></div>

<form asp-action="Edit"
      method="post"
      enctype="multipart/form-data">

    <input type="hidden" asp-for="Id" />

    <div>
        <label asp-for="Title">Название</label>
        <input asp-for="Title" />
        <span asp-validation-for="Title"></span>
    </div>

    <div>
        <label asp-for="Director">Режиссёр</label>
        <input asp-for="Director" />
        <span asp-validation-for="Director"></span>
    </div>

    <div>
        <label asp-for="Genre">Жанр</label>
        <input asp-for="Genre" />
        <span asp-validation-for="Genre"></span>
    </div>

    <div>
        <label asp-for="Year">Год</label>
        <input asp-for="Year" type="number" />
        <span asp-validation-for="Year"></span>
    </div>

    <div>
        <label asp-for="Description">Описание</label>
        <textarea asp-for="Description"></textarea>
        <span asp-validation-for="Description"></span>
    </div>

    <div>
        <p>Текущий постер:</p>

        @if (!string.IsNullOrEmpty(Model.Poster))
        {
            <img src="@Model.Poster"
                 alt="@Model.Title"
                 style="max-width: 200px;" />
        }
    </div>

    <div>
        <label>Новый постер</label>
        <input type="file"
               name="posterFile"
               accept="image/*" />
    </div>

    <button type="submit">
        Сохранить изменения
    </button>

</form>

<br />

<a asp-action="Details" asp-route-id="@Model.Id">
    Вернуться к фильму
</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}