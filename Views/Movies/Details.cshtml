@model films_dz12._08._2026.Models.Movie

@{
    ViewData["Title"] = "Информация о фильме";
}

<h1>Информация о фильме</h1>

<div>
    @if (!string.IsNullOrEmpty(Model.Poster))
    {
        <img src="@Model.Poster"
             alt="@Model.Title"
             style="max-width: 300px;" />
    }

    <h2>@Model.Title</h2>

    <p>
        <strong>Режиссёр:</strong>
        @Model.Director
    </p>

    <p>
        <strong>Жанр:</strong>
        @Model.Genre
    </p>

    <p>
        <strong>Год:</strong>
        @Model.Year
    </p>

    <p>
        <strong>Описание:</strong>
        @Model.Description
    </p>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id">
    Редактировать
</a>

<a asp-controller="Home" asp-action="Index">
    Вернуться к фильмам
</a>